[
  {
    "id": 0,
    "text": "你正站在吉萨金字塔旁",
    "L": -1,
    "moment": false
  },
  {
    "id": 1,
    "text": "古代世界七大奇迹中，最古老的这座也是唯一留存至今的",
    "L": 0.25,
    "moment": false
  },
  {
    "id": 2,
    "text": "这是褪去皮肤与肌肉之后的你",
    "L": 0.8,
    "moment": false
  },
  {
    "id": 3,
    "text": "在不到 2 毫米的皮肤下，成年人都有相同的 206 块骨骼",
    "L": 0.81,
    "moment": true
  },
  {
    "id": 4,
    "text": "所有人类的 DNA 有 99.6% 相同",
    "L": 0.82,
    "moment": true
  },
  {
    "id": 5,
    "text": "肤色的差异，来自薄如纸张的一层组织",
    "L": 0.83,
    "moment": true
  },
  {
    "id": 6,
    "text": "今天生活在地球上的 80 亿人，都有着同样的骨架",
    "L": 0.84,
    "moment": true
  },
  {
    "id": 7,
    "text": "建造金字塔的石灰岩，来自 4,500 万年前的海洋贝壳",
    "L": 1.7,
    "moment": false
  },
  {
    "id": 8,
    "text": "大金字塔曾保持世界最高建筑的纪录超过 3,700 年",
    "L": 2.25,
    "moment": false
  },
  {
    "id": 9,
    "text": "金字塔建造者居住的小镇，位于狮身人面像以南 400 米",
    "L": 2.85,
    "moment": false
  },
  {
    "id": 10,
    "text": "金字塔旁的大开罗地区，生活着 2,300 万人",
    "L": 3.6,
    "moment": false
  },
  {
    "id": 11,
    "text": "95% 的埃及人生活在尼罗河两岸 20 千米以内",
    "L": 4.15,
    "moment": false
  },
  {
    "id": 12,
    "text": "向上 100 千米就到了太空：相当于开车垂直向上约一小时",
    "L": 4.7,
    "moment": false
  },
  {
    "id": 13,
    "text": "地球上 99% 的空气，都聚集在距地面 30 千米以内",
    "L": 5.2,
    "moment": false
  },
  {
    "id": 14,
    "text": "2,250 年前，埃拉托色尼用影子测出了地球的大小",
    "L": 5.7,
    "moment": false
  },
  {
    "id": 15,
    "text": "7,000 年前，撒哈拉还是遍布湖泊的草原",
    "L": 6.2,
    "moment": false
  },
  {
    "id": 16,
    "text": "那些灯光，是从波斯湾延伸到印度的城市",
    "L": 7.05,
    "moment": false
  },
  {
    "id": 17,
    "text": "地球是目前唯一已知存在生命的地方",
    "L": 7.45,
    "moment": false
  },
  {
    "id": 18,
    "text": "迄今只有 12 个人曾在月球上行走",
    "L": 7.85,
    "moment": false
  },
  {
    "id": 19,
    "text": "2026 年 4 月，阿尔忒弥斯二号宇航员飞到了人类此前未及的远方",
    "L": 8.55,
    "moment": false
  },
  {
    "id": 20,
    "text": "当地月相距最远时，其余七颗行星都能排进它们之间",
    "L": 8.95,
    "moment": false
  },
  {
    "id": 21,
    "text": "阳光抵达金字塔，需要 8 分钟",
    "L": 9.4,
    "moment": false
  },
  {
    "id": 22,
    "text": "以每小时 100 千米开车前往太阳，需要 170 年",
    "L": 9.85,
    "moment": false
  },
  {
    "id": 23,
    "text": "太阳内部可以装下 130 万个地球",
    "L": 10.35,
    "moment": false
  },
  {
    "id": 24,
    "text": "1672 年，天文学家借助火星测出了太阳的距离",
    "L": 10.95,
    "moment": false
  },
  {
    "id": 25,
    "text": "火星上的一年，相当于地球上的 687 天",
    "L": 11.6,
    "moment": false
  },
  {
    "id": 26,
    "text": "如果太阳是一扇门，地球就是 215 米外的一枚硬币",
    "L": 12.15,
    "moment": false
  },
  {
    "id": 27,
    "text": "太阳与行星占据的空间，不到太阳系的十亿分之一",
    "L": 12.4,
    "moment": false
  },
  {
    "id": 28,
    "text": "1990 年，旅行者一号从这里回望地球，它还不到一个像素",
    "L": 12.7,
    "moment": false
  },
  {
    "id": 29,
    "text": "海王星上的一年，相当于地球上的 165 年",
    "L": 12.95,
    "moment": false
  },
  {
    "id": 30,
    "text": "旅行者一号是距离人类最遥远的人造物体",
    "L": 13.25,
    "moment": false
  },
  {
    "id": 31,
    "text": "旅行者一号以每秒 17 千米穿行虚空，已经走过 49 年",
    "L": 14.1,
    "moment": false
  },
  {
    "id": 32,
    "text": "比邻星是最近的恒星，距离我们 4.2 光年",
    "L": 15.3,
    "moment": false
  },
  {
    "id": 33,
    "text": "比邻星离我们约有 31 亿个地球直径那么远",
    "L": 15.42,
    "moment": false
  },
  {
    "id": 34,
    "text": "一光年，约等于 9.5 万亿千米",
    "L": 15.55,
    "moment": false
  },
  {
    "id": 35,
    "text": "如果太阳是一粒沙，最近的恒星就在 29 千米之外",
    "L": 15.85,
    "moment": false
  },
  {
    "id": 36,
    "text": "恒星之间，每立方厘米的空间里大约只有一个原子",
    "L": 16.1,
    "moment": false
  },
  {
    "id": 37,
    "text": "海平面的空气中，每立方厘米有约 250 亿亿个分子",
    "L": 16.35,
    "moment": false
  },
  {
    "id": 38,
    "text": "旅行者一号需要 75,000 年，才能到达最近的恒星",
    "L": 16.6,
    "moment": false
  },
  {
    "id": 39,
    "text": "1838 年，弗里德里希·贝塞尔首次测出了恒星的距离",
    "L": 16.85,
    "moment": false
  },
  {
    "id": 40,
    "text": "自 20 世纪 20 年代以来，我们的无线电信号已经走过 100 光年",
    "L": 17.95,
    "moment": false
  },
  {
    "id": 41,
    "text": "已发现的 6,000 多颗系外行星中，尚未找到生命",
    "L": 18.55,
    "moment": false
  },
  {
    "id": 42,
    "text": "即使从大爆炸起以每小时 100 千米开车，也只能走过 1,300 光年",
    "L": 19.05,
    "moment": false
  },
  {
    "id": 43,
    "text": "银河系拥有 1,000 亿至 4,000 亿颗恒星",
    "L": 19.6,
    "moment": false
  },
  {
    "id": 44,
    "text": "银河系中的行星，比恒星还多",
    "L": 19.75,
    "moment": false
  },
  {
    "id": 45,
    "text": "银河系的直径，约等于 74 万亿个地球直径",
    "L": 19.9,
    "moment": false
  },
  {
    "id": 46,
    "text": "来自银心的光，在 27,000 年前就已出发",
    "L": 20.1,
    "moment": false
  },
  {
    "id": 47,
    "text": "1918 年，沙普利证明太阳远离银河系中心",
    "L": 20.9,
    "moment": false
  },
  {
    "id": 48,
    "text": "银心有一个质量约为太阳 400 万倍的黑洞",
    "L": 21.25,
    "moment": false
  },
  {
    "id": 49,
    "text": "本星系群拥有超过 100 个星系",
    "L": 22,
    "moment": false
  },
  {
    "id": 50,
    "text": "仙女座星系离我们约有 1,900 万亿个地球直径那么远",
    "L": 22.2,
    "moment": false
  },
  {
    "id": 51,
    "text": "这束光离开仙女座星系时，早期人类还生活在非洲",
    "L": 22.4,
    "moment": false
  },
  {
    "id": 52,
    "text": "星系相撞时，其中的恒星几乎不会彼此碰撞",
    "L": 22.6,
    "moment": false
  },
  {
    "id": 53,
    "text": "1924 年，埃德温·哈勃证明仙女座是另一个星系",
    "L": 22.8,
    "moment": false
  },
  {
    "id": 54,
    "text": "如果银河系是一个盘子，仙女座星系就在 6.5 米之外",
    "L": 23.2,
    "moment": false
  },
  {
    "id": 55,
    "text": "本星系群，只是室女座超星系团的一小部分",
    "L": 23.55,
    "moment": false
  },
  {
    "id": 56,
    "text": "来自室女座星系团的光，在 5,400 万年前就已出发",
    "L": 23.9,
    "moment": false
  },
  {
    "id": 57,
    "text": "首个被拍到的黑洞，质量约为太阳的 65 亿倍",
    "L": 24.2,
    "moment": false
  },
  {
    "id": 58,
    "text": "星系聚成绵长的丝状结构，围绕着近乎空无的巨洞",
    "L": 24.5,
    "moment": false
  },
  {
    "id": 59,
    "text": "拉尼亚凯亚容纳着约 10 万个星系",
    "L": 24.62,
    "moment": false
  },
  {
    "id": 60,
    "text": "拉尼亚凯亚在夏威夷语中，意为「无尽的天空」",
    "L": 24.75,
    "moment": false
  },
  {
    "id": 61,
    "text": "那条暗带，是银河系自身的尘埃与恒星遮住了视野",
    "L": 25,
    "moment": false
  },
  {
    "id": 62,
    "text": "牧夫座空洞横跨 3 亿光年，其中却鲜有星系",
    "L": 25.2,
    "moment": false
  },
  {
    "id": 63,
    "text": "普通原子物质，只占宇宙总量的 5%",
    "L": 25.3,
    "moment": false
  },
  {
    "id": 64,
    "text": "平均而言，宇宙每五立方米空间里只有一个原子",
    "L": 25.45,
    "moment": false
  },
  {
    "id": 65,
    "text": "20 世纪 20 年代，勒梅特与哈勃发现宇宙正在膨胀",
    "L": 25.55,
    "moment": false
  },
  {
    "id": 66,
    "text": "这里包含了光曾抵达我们的一切",
    "L": 25.95,
    "moment": false
  },
  {
    "id": 67,
    "text": "由于空间持续膨胀，它如今的直径达 930 亿光年",
    "L": 26.25,
    "moment": false
  },
  {
    "id": 68,
    "text": "可观测宇宙的直径，约等于 6,900 万万亿个地球直径",
    "L": 26.38,
    "moment": false
  },
  {
    "id": 69,
    "text": "1965 年，人们意外发现了我们能看到的最古老的光",
    "L": 26.5,
    "moment": false
  },
  {
    "id": 70,
    "text": "来自边缘的光在 138 亿年前出发，如今才抵达这里",
    "L": 27.05,
    "moment": false
  },
  {
    "id": 71,
    "text": "从地球能够看见的一切，都在这个小点之中",
    "L": 28.2,
    "moment": false
  }
]
